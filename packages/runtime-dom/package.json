    "version": "1.0.0",
    "main": "dist/runtime-dom.cjs.js",
    "module": "dist/runtime-dom.esm-bundler.js",
    "unpkg": "dist/runtime-dom.global.js",
    "types": "dist/runtime-dom.d.ts",
